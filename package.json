{
  "name": "sflights-cap",
  "version": "1.0.0",
  "description": "SAP Flight Model — BTP CAP CDS Project",
  "repository": "https://github.com/AKS91/sflights-xsa",
  "license": "MIT",
  "dependencies": {
    "@sap/cds": "^9.7.1",
    "@cap-js/hana": "^2.6.0",
    "@sap/xssec": "^4.12.2",
    "@gavdi/cap-mcp": "^1",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.3",
    "@sap/cds-dk": "^9.7.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "mcp": {
      "name": "sflights-mcp",
      "auth": "inherit"
    },
    "requires": {
      "db": {
        "kind": "sql"
      },
      "[production]": {
        "db": {
          "kind": "hana-cloud"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
